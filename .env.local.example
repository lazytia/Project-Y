# Google Programmable Search — powers the company summary shown when staff
# tap a company name on a reservation. Optional locally: without a key the
# lookup falls back to guessing the company website from its name.
# cx is a public identifier; the API key is billable and lives in Secret
# Manager in production (see apphosting.yaml).
GOOGLE_CSE_CX=
GOOGLE_CSE_API_KEY=
