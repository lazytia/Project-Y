rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Owners are identified by the synthetic email we mint from usernames
    // (see src/lib/username.ts → usernameToEmail). Keep this list in sync with
    // OWNER_USERNAMES in src/lib/permissions.ts.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in [
          "tia@projecty.local",
          "yurica@projecty.local",
          "eddie@projecty.local"
        ];
    }

    // Keep in sync with CHEF_USERNAMES in src/lib/permissions.ts
    function isChef() {
      return request.auth != null
        && request.auth.token.email in [
          "chinglam@projecty.local",
          "chuck@projecty.local"
        ];
    }

    // Staff onboarding:
    //  - Any signed-in user can read (manager view at /people/onboarding lists
    //    every doc; the app's sign-in is currently restricted to owner accounts).
    //  - Staff can write their OWN doc (onboarding form progress).
    //  - Owners can write ANY staff doc (seeding new staff accounts from the
    //    Staff + page, sending reminders, pruning invalid FCM tokens, etc.).
    //  - Staff cannot change a start date once the record has one. It is the
    //    date the owner entered, it sets when the pay rate steps up, and the
    //    onboarding screen used to replace it with the moment of each sign-in
    //    (Masahiro's and Yuki's, repeatedly) from whichever version of the app a
    //    phone happened to be running. A rule holds for all of them.
    //    Only an update has an existing record to compare with, so the check sits
    //    on update alone.
    function keepsStartDate() {
      return !('startDate' in resource.data)
        || request.resource.data.startDate == resource.data.startDate;
    }

    //  - Staff cannot set their own pay. Timesheets pay every shift from the
    //    rates (src/lib/staff-rates.ts), and find whose rates those are by the
    //    two Square ids (src/lib/timesheet-shifts-server.ts) — so an employee
    //    who could change an id could have their shifts, or a colleague's, paid
    //    at someone else's rate. Only the owner's and head chef's screens write
    //    these fields; no screen of the employee's own does. A record the
    //    employee creates themselves must not carry them either, or writing a
    //    missing record afresh would get round the update check.
    //  - Staff cannot delete their own record. It holds their pay, their
    //    signed documents and their onboarding; only the owner's screens
    //    delete one, and deleting it was also a way round every check above.
    function payFields() {
      return [
        'weekdayRate', 'saturdayRate', 'trainingRate', 'afterTrainingRate', 'rateChanges',
        'squareTeamMemberId', 'squareStaffId'
      ];
    }

    function keepsPayFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(payFields());
    }

    function setsNoPayFields() {
      return !request.resource.data.keys().hasAny(payFields());
    }

    //  - What a staff member has entered, they may correct but not take away.
    //    Every field already on the record has to still be there afterwards,
    //    so a write cannot drop one. Their own screens save with merge, which
    //    never removes a key, so an honest save is unaffected; what this stops
    //    is a crafted write that empties the record a field at a time — the
    //    same end as deleting it, reached under the update rule.
    //
    //    It deliberately does not require the values to stay filled in. The
    //    documents step writes `rsaUrl: null` for anyone who needs no RSA and
    //    the tax step writes "" for the optional answers, so a rule against
    //    empty values would block the forms themselves. Changing a value is
    //    editing, which is allowed; losing the field is not.
    function keepsEveryField() {
      return request.resource.data.keys().hasAll(resource.data.keys());
    }

    //  - A cancellation request is the kitchen's or the floor's to raise about
    //    a new hire, and an owner's to answer. An employee has no business
    //    writing one on their own record — about themselves it would only be
    //    noise on the owner's list, and about the field itself it is the one
    //    thing on the record that asks for the record to go.
    function setsNoCancelRequest() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['cancelRequest']);
    }

    match /staff_onboarding/{uid} {
      allow read: if request.auth != null;
      allow create: if isOwner() || isChef()
        || (request.auth != null && request.auth.uid == uid && setsNoPayFields());
      // Deleting a staff record is the owners' alone. The head chef had it
      // too until 2026-11-25, when two new hires were deleted and the only
      // thing anybody could say for certain was that it came from one of the
      // five accounts that were allowed to. Five is too many for something
      // this hard to undo, and the kitchen never needed it.
      allow delete: if isOwner();
      allow update: if isOwner() || isChef()
        || (request.auth != null && request.auth.uid == uid
            && keepsStartDate() && keepsPayFields() && keepsEveryField()
            && setsNoCancelRequest());
    }

    // The copy of a staff record taken when one is deleted, written by
    // lib/staff-archive just before the original goes.
    //
    // Create and read only — on purpose. An entry here is the last thing
    // standing between a mistaken delete and a record nobody can get back,
    // so whoever can delete a staff member can file and read these, and
    // nobody at all can edit or remove one.
    match /staff_deleted/{entryId} {
      allow read: if isOwner() || isChef();
      allow create: if isOwner();
    }

    // Published rosters: weekly docs keyed by Monday ISO date. Shift
    // assignments, per-day counts, notes and the publish stamp live here.
    // Staff need read access so the staff roster page can display the same
    // data.
    //
    // The head chef builds and publishes the roster, so a chef writes it the
    // same way an owner does. Chefs used to be held to the `notes` field only,
    // which let them annotate a week but not staff or publish it. Deleting a
    // week stays with the owners: no screen deletes one.
    match /rosters_published/{weekStartISO} {
      allow read: if request.auth != null;
      allow create, update: if isOwner() || isChef();
      allow delete: if isOwner();
    }

    // Weekly Square gross sales — written by the Square sync job
    // (server) every cron tick. Read by the Insights dashboard.
    match /sales_weekly/{weekStartISO} {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }

    // Weekly payroll totals — written by the Xero sync job (server)
    // or by an owner via a manual entry form, read by the Insights
    // dashboard. Documents are keyed by the Monday ISO date of the
    // pay-run's work week and contain { gross, super, payDate }.
    match /payroll_weekly/{weekStartISO} {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }

    // Cash payments: owner + manager only. Tracks every recorded
    // cash payment to candidates or active employees.
    match /cash_payments/{paymentId} {
      allow read, write: if isOwner() || isChef();
    }

    // HR notes: manager-only. Each note records a Formal Warning,
    // Performance Review, Incident Report, or Other note for a staff
    // member. Staff never see this collection.
    match /hr_notes/{noteId} {
      allow read, write: if isOwner() || isChef();
    }

    // Notice Given: records employees who have submitted resignation notice.
    // Owner-only read/write.
    match /notice_given/{noticeId} {
      allow read, write: if isOwner() || isChef();
    }

    // Sold-out category definitions — static config written by owners,
    // read by all signed-in users.
    match /sold_out_categories/{docId} {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }

    // Daily sold-out state — keyed by YYYY-MM-DD. A missing doc means
    // nothing is sold out for that day (auto-reset by date change).
    //
    // The head chef runs out of fish before anyone else knows, so a chef
    // switches categories off the same way an owner does. The page's other half,
    // /api/menu/set-sold-out, lets the same two groups through.
    match /sold_out_daily/{docId} {
      allow read: if request.auth != null;
      allow write: if isOwner() || isChef();
    }

    // Catering orders — event jobs surfaced on /operations/catering-orders.
    // Operations team (owners + managers + any signed-in staff) can create,
    // edit, and delete orders; everyone signed in can read.
    match /catering_orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    // Catering orders the owner has chosen to hide from the app's
    // calendar (Square remains untouched — this collection is the only
    // record of the hide). Written only by /api/catering-orders/[orderId]
    // DELETE via the admin SDK; the client never reads or writes it.
    match /catering_hidden/{orderId} {
      allow read, write: if isOwner();
    }

    // Owner's daily "Today's Sales Review" notes on the dashboard, keyed
    // by YYYY-MM-DD. Owner-only for both reads and writes — this is
    // internal commentary that shouldn't leak beyond owner-level accounts.
    match /sales_reviews/{dateISO} {
      allow read, write: if isOwner();
    }

    // Daily gross sales snapshot — keyed by YYYY-MM-DD. Populated by the
    // Square sync cron (server admin bypass) AND by the owner dashboard
    // whenever it fetches fresh stats, so past days keep their number
    // even if Square is unreachable later. Signed-in read (Insights
    // dashboard consumes it too), owner-only write from the client.
    match /sales_daily/{dateISO} {
      allow read: if request.auth != null;
      allow write: if isOwner();
    }

    // Local overrides for Square Labor shifts — owner-edited start/end
    // times that stay in Firestore only (never pushed back to Square).
    // Doc id matches the Square shift id so we can join in the client.
    match /timesheet_edits/{shiftId} {
      allow read, write: if isOwner();
    }

    // App-local shifts backfilled by the owner when Square Labor missed
    // a clock-in / clock-out. These are NEVER pushed to Square either;
    // they appear alongside the Square feed in the timesheets UI only.
    match /timesheet_extra_shifts/{docId} {
      allow read, write: if isOwner();
    }

    // Square shifts the owner removed from the timesheet UI. Square Labor
    // is unchanged; we filter these out when merging the feed.
    match /timesheet_dismissed/{shiftId} {
      allow read, write: if isOwner();
    }

    // Owner dashboard "Noted" dismissals — keyed by auth uid so Noted All
    // survives app restarts, PWA reinstalls, and device switches.
    match /dashboard_attention_noted/{uid} {
      allow read, write: if isOwner() && request.auth.uid == uid;
    }

    // Signed acknowledgements of internal documents (Staff Handbook, Beer
    // Guide), one doc per signer. Kept out of staff_onboarding because that
    // collection is enumerated to build the People lists — a manager signing
    // the handbook must not become an employee record.
    // A signature is evidence that somebody read and accepted a document, so
    // the signer may add one and sign a newer version over it, but cannot
    // take one back. Nobody deletes these from a screen; the admin SDK can
    // where it ever has to.
    match /document_signatures/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }

    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
